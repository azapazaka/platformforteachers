# Скопируйте этот файл в .env и вставьте свои ключи: https://console.groq.com/keys
# На Vercel эти же переменные задаются в Settings → Environment Variables.
#
# Можно указать до 10 ключей. Если один упрётся в лимит или перестанет работать,
# сайт автоматически возьмёт следующий. Достаточно заполнить хотя бы один.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Необязательно: модель Groq. По умолчанию openai/gpt-oss-120b.
# GROQ_MODEL=openai/gpt-oss-120b
